# Shop Service Environment Variables
SERVER_PORT=8088

DB_HOST=localhost
DB_PORT=5432
DB_NAME=shop_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here

# Redis Cache (đặt CACHE_TYPE=simple nếu chạy local chưa bật Redis)
CACHE_TYPE=redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# PayOS Configuration (Phase B)
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key
PAYOS_RETURN_URL=http://localhost:5173/shop/payment/success
PAYOS_CANCEL_URL=http://localhost:5173/shop/payment/cancel
SHOP_ORDER_EXPIRE_MINUTES=15
SHOP_ORDER_RECONCILE_DELAY_MS=60000
VIETQR_TEMPLATE_URL=https://img.vietqr.io/image

# Inter-Service URL & Features
WALLET_SERVICE_URL=http://localhost:8089
FEATURES_SANDBOX_PAYMENT_ENABLED=true

# S3 / MinIO Object Storage (53 Card Skin Assets)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=your_minio_access_key
S3_SECRET_KEY=your_minio_secret_key
S3_BUCKET=poker-assets
S3_PUBLIC_URL=http://localhost:9000/poker-assets
