API_GATEWAY_PORT=8080
IDENTITY_SERVICE_PORT=8081
AUTH_SERVICE_PORT=8090
GAME_SERVICE_PORT=8082
MATCHMAKING_SERVICE_PORT=8083
SOCIAL_SERVICE_PORT=8084
CHAT_SERVICE_PORT=8085
RANKING_SERVICE_PORT=8086
COMPETITION_SERVICE_PORT=8087
SHOP_SERVICE_PORT=8088
WALLET_SERVICE_PORT=8089

# auth-service local development (see auth-service/README.md).
AUTH_DB_URL=jdbc:postgresql://localhost:54330/auth_db
AUTH_DB_USERNAME=poker
AUTH_DB_PASSWORD=poker_dev

# Gmail SMTP: use your Gmail address and a Google App Password, not your login password.
# AUTH_MAIL_FROM should match AUTH_MAIL_USERNAME.
AUTH_MAIL_HOST=smtp.gmail.com
AUTH_MAIL_PORT=587
AUTH_MAIL_FROM=your-email@gmail.com
AUTH_MAIL_USERNAME=
AUTH_MAIL_PASSWORD=
AUTH_MAIL_SMTP_AUTH=true
AUTH_MAIL_STARTTLS=true
AUTH_OTP_TTL=5m
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN=60s
AUTH_RABBIT_HOST=localhost
AUTH_RABBIT_PORT=5673
# Leave unset for Compose defaults: shared broker guest/guest; auth dev poker/poker_dev.
# Set both only when overriding credentials (the dev app and broker use the same values).
# AUTH_RABBIT_USERNAME=
# AUTH_RABBIT_PASSWORD=
AUTH_EVENTS_DISPATCH_ENABLED=true
# Delay between batches in milliseconds.
AUTH_EVENTS_DISPATCH_DELAY=5000

# Swagger UI and OpenAPI JSON for auth-service.
AUTH_SWAGGER_ENABLED=true

# Login sessions; local HTTP only. Deploy with HTTPS and AUTH_COOKIE_SECURE=true.
JWT_ISSUER=http://localhost:8090
JWT_AUDIENCE=poker
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=7d
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
AUTH_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8090,http://localhost:8080
# Dev creates a persistent RSA key once. Provision the key and disable generation when deploying.
AUTH_JWT_GENERATE_KEY=true
# Host Java only; Compose uses /app/keys/jwt-private.pem in its auth-keys volume.
AUTH_JWT_PRIVATE_KEY_PATH=.local/auth/jwt-private.pem

# Preset avatar URLs use the public API origin, normally the gateway. Auth-only: localhost:8090.
AUTH_PUBLIC_BASE_URL=http://localhost:8080
AUTH_AVATAR_MAX_FILE_SIZE=2MB
# Fill in S3 credentials/bucket, configure bucket CORS, then enable direct FE uploads.
AUTH_S3_ENABLED=false
AUTH_S3_REGION=ap-southeast-1
AUTH_S3_BUCKET=
AUTH_S3_ACCESS_KEY=
AUTH_S3_SECRET_KEY=
AUTH_S3_AVATAR_PREFIX=avatars
AUTH_S3_UPLOAD_TTL=5m
AUTH_S3_VIEW_TTL=1h

# Daily check-in rewards (auth calls wallet directly over the internal network).
AUTH_CHECKIN_REWARD_COINS=50
AUTH_CHECKIN_RETRY_ENABLED=true
AUTH_CHECKIN_RETRY_DELAY=5000
AUTH_CHECKIN_RETRY_BACKOFF=30s
# Leave unset: Java on host uses localhost:8089; Compose uses wallet-service:8089.
# AUTH_WALLET_BASE_URL=
AUTH_WALLET_CONNECT_TIMEOUT=2s
AUTH_WALLET_REQUEST_TIMEOUT=5s
