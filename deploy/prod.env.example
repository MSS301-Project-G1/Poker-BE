# Template for ~/poker/be/.env on the VPS (chmod 600, never commit the real file).
# Only production overrides are listed; every other key falls back to its compose default.
COMPOSE_PROJECT_NAME=poker
# Written by deploy/remote-deploy.sh on every deploy.
IMAGE_TAG=

# Public origin (FE and backend share it through nginx)
GATEWAY_CORS_ALLOWED_ORIGINS=https://game-fun.me
GATEWAY_SWAGGER_ENABLED=true
AUTH_CORS_ALLOWED_ORIGINS=https://game-fun.me
GAME_ALLOWED_ORIGINS=https://game-fun.me
SOCIAL_ALLOWED_ORIGINS=https://game-fun.me
CHAT_ALLOWED_ORIGINS=https://game-fun.me
JWT_ISSUER=https://game-fun.me
AUTH_COOKIE_SECURE=true
PAYOS_RETURN_URL=https://game-fun.me/shop/payment/success
PAYOS_CANCEL_URL=https://game-fun.me/shop/payment/cancel

# Internal service keys and database passwords: random values, e.g. `openssl rand -hex 24`.
# Database passwords only apply when the volume is created; change them inside Postgres afterwards.
GAME_SERVICE_KEY=
AUTH_SESSION_INTERNAL_KEY=
SOCIAL_GATEWAY_KEY=
CHAT_GATEWAY_KEY=
SOCIAL_INTERNAL_KEY=
CHAT_INTERNAL_KEY=
WALLET_INTERNAL_KEY=
SHOP_INTERNAL_KEY=
WALLET_GATEWAY_KEY=
SHOP_GATEWAY_KEY=
MATCHMAKING_GATEWAY_KEY=
RANKING_GATEWAY_KEY=
RANKING_INTERNAL_KEY=
COMPETITION_GATEWAY_KEY=
AUTH_DB_PASSWORD=
GAME_DB_PASSWORD=
MATCHMAKING_DB_PASSWORD=
SOCIAL_DB_PASSWORD=
CHAT_DB_PASSWORD=
RANKING_DB_PASSWORD=
COMPETITION_DB_PASSWORD=
SHOP_DB_PASSWORD=
WALLET_DB_PASSWORD=

# Keep the PostgreSQL major version used by the existing volume (16 if it was created with 16).
# These defaults are for new PostgreSQL 17 volumes; this does not migrate existing data.
SHOP_POSTGRES_IMAGE=postgres:17-alpine
WALLET_POSTGRES_IMAGE=postgres:17-alpine

# Call the real services when deployed.
MATCHMAKING_WALLET_STUB_ENABLED=false
MATCHMAKING_RESTRICTION_STUB_ENABLED=false

# Gmail SMTP (OTP mail): Google App Password, not the login password
AUTH_MAIL_FROM=
AUTH_MAIL_USERNAME=
AUTH_MAIL_PASSWORD=

# AWS S3: auth avatars and shop files share the team bucket and IAM user
AUTH_S3_ENABLED=true
AUTH_S3_REGION=ap-southeast-1
AUTH_S3_BUCKET=the-one-bucket-vippro
AUTH_S3_ACCESS_KEY=
AUTH_S3_SECRET_KEY=
S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
S3_BUCKET=the-one-bucket-vippro
S3_PUBLIC_URL=https://the-one-bucket-vippro.s3.ap-southeast-1.amazonaws.com
S3_ACCESS_KEY=
S3_SECRET_KEY=

# PayOS
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
SHOP_WALLET_TIMEOUT=3s

# Demo accounts: created at startup when missing. Use strong passwords on the public site.
DATA_INIT_ENABLED=true
DATA_INIT_ADMIN_EMAIL=
DATA_INIT_ADMIN_PASSWORD=
DATA_INIT_ADMIN_DISPLAY_NAME=
DATA_INIT_USER_EMAIL=
DATA_INIT_USER_PASSWORD=
DATA_INIT_USER_DISPLAY_NAME=
DATA_INIT_SECONDARY_USER_EMAIL=
DATA_INIT_SECONDARY_USER_DISPLAY_NAME=
DATA_INIT_UNVERIFIED_USER_EMAIL=
DATA_INIT_UNVERIFIED_USER_DISPLAY_NAME=
